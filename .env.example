# OneFlow 环境变量模板 —— 复制为 .env 并填写
# LLM（用户自选厂商）
# OpenAI 示例：
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
LLM_API_KEY=
LLM_BASE_URL=
# 云端 Qwen（阿里云百炼）示例：
# LLM_PROVIDER=openai
# LLM_MODEL=qwen/qwen3.8-max
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek 示例（OpenAI 兼容端点）：
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com

# 订酒店（可选，用户自填 URL 与 Key；未填则工具明确报错）
HOTEL_BASE_URL=
HOTEL_API_KEY=

# 鉴权
JWT_SECRET=please-change-me

# Agent
MAX_STEPS=15
DB_PATH=./oneflow.db
